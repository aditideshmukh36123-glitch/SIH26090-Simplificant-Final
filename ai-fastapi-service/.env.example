# Visual Forge — environment configuration
# Copy this file to .env and fill in the real values. NEVER commit .env.

# Cloudinary (product image hosting + heavy-lifting cleaning)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Gemini — backend for the 'gemini' AI_PROVIDER option
GEMINI_API_KEY=your-gemini-api-key

# Groq (Whisper + Llama 4 Scout) — backend for the 'groq' AI_PROVIDER option.
# Get a free key at console.groq.com — used for the 'groq' AI_PROVIDER option.
GROQ_API_KEY=your-groq-api-key

# API protection — X-API-Key header required on protected routes
X_API_KEY=replace-with-a-long-random-secret

# Optional overrides:
# AI_PROVIDER=groq            # catalog-audio backend: "groq" (default) or "gemini"
# FILE_ACTIVE_POLL_INTERVAL_SECONDS=0.5
# API_BASE_URL=http://127.0.0.1:8000   # demo_ui.py default API location