# SIH26090 — AI microservice environment
# Copy to .env and fill in real values.

# FastAPI
AI_PORT=5000
AI_ENV=development

# Google Gemini (multimodal vision + transcription). Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional model override per service (defaults: gemini-1.5-flash)
GEMINI_MODEL="gemini-1.5-flash"

# Cloudinary (Studio clean + raw media hosting). https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Root folder prefix for uploaded artifacts (create-on-demand)
CLOUDINARY_FOLDER="sih26090/ai"