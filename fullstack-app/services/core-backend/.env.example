# SIH26090 — Core Backend environment
# Copy to .env and fill in real values.

# Neon Serverless PostgreSQL.
# DATABASE_URL: pooled (pgbouncer) host for regular queries.
# DATABASE_DIRECT_URL: direct (non-pooled) host — required by Prisma for
# interactive transactions (atomic checkout, OTP-gated escrow release).
# In the Neon dashboard copy each string separately from the two tabs.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require&pgbouncer=true"
DATABASE_DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

PORT=4000
NODE_ENV=development

# Comma-separated allowed origins, or * to reflect any origin during development.
CORS_ORIGIN=*

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<48-hex-chars>
JWT_REFRESH_SECRET=<48-hex-chars>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AES-256-GCM key for OTP encryption-at-rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<32-byte-hex>