{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SIH26090 to access photos so artisans can upload workshop images and narration audio.",
          "cameraPermission": "Allow SIH26090 to use the camera so artisans can photograph their crafts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SIH26090 to use your microphone for voice notes and descriptions."
        }
      ]
    ]
  }
}
