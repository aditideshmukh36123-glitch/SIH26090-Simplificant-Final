# SIH26090 — Mobile (Expo) environment
# Copy to .env (in apps/mobile) and set real values.
# Any variable prefixed EXPO_PUBLIC_ is inlined at build time by Metro.

# Core backend (Express) — default http://localhost:4000/api/v1
# For a physical device on the same Wi-Fi use your computer's LAN IP:
#   http://192.168.x.x:4000/api/v1
EXPO_PUBLIC_CORE_API_URL=http://localhost:4000/api/v1

# AI microservice (FastAPI) — default http://localhost:5000/api
EXPO_PUBLIC_AI_API_URL=http://localhost:5000/api